#!/usr/bin/env python3
"""Build a hollow F127 shell with any number of chains.

Only the 34-chain structure shipped, so the wizard would take an aggregation
number, size the box for it, draw it, and then the build would refuse. A shell
is a regular object, though: every chain points its poly(propylene oxide) block
inward and its poly(ethylene oxide) blocks outward, so one chain lifted out of
the existing shell can be copied onto as many directions as are wanted.

Directions come from a Fibonacci lattice, which spaces points on a sphere evenly
without the crowding at the poles that latitude and longitude give. Each copy is
rotated so the chain's own inward axis lines up with its direction, then spun by
a random angle about that axis so the copies are not clones in register.

The result is a starting structure, not an equilibrated one. It goes through the
same energy minimisation and equilibration as the shipped shell.

    python make_shell.py 50 out.gro           50 chains
    python make_shell.py 50 out.gro --radius 3.4

Pukyong National University / NCHM Lab.  Eunryul Jeon <qlsguswjs@pukyong.ac.kr>
"""
import argparse
from pathlib import Path

import numpy as np

ROOT = Path(__file__).resolve().parent.parent
SRC = ROOT / "data" / "f127_shell_bare.gro"
PER_CHAIN = 2053


def read_gro(path):
    L = Path(path).read_text().splitlines()
    n = int(L[1])
    rows = L[2:2 + n]
    pos = np.array([[float(r[20:28]), float(r[28:36]), float(r[36:44])] for r in rows])
    return rows, pos


def rotation(a, b):
    """Rotation taking unit vector a onto unit vector b."""
    v = np.cross(a, b)
    c = float(np.dot(a, b))
    if np.allclose(v, 0):
        return np.eye(3) if c > 0 else -np.eye(3)
    k = np.array([[0, -v[2], v[1]], [v[2], 0, -v[0]], [-v[1], v[0], 0]])
    return np.eye(3) + k + k @ k * (1 / (1 + c))


def spin(axis, angle):
    a = axis / np.linalg.norm(axis)
    k = np.array([[0, -a[2], a[1]], [a[2], 0, -a[0]], [-a[1], a[0], 0]])
    return np.eye(3) + np.sin(angle) * k + (1 - np.cos(angle)) * k @ k


def fibonacci(n):
    i = np.arange(n) + 0.5
    phi = np.arccos(1 - 2 * i / n)
    theta = np.pi * (1 + 5 ** 0.5) * i
    return np.stack([np.cos(theta) * np.sin(phi),
                     np.sin(theta) * np.sin(phi), np.cos(phi)], 1)


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("chains", type=int)
    ap.add_argument("out")
    ap.add_argument("--radius", type=float, default=None,
                    help="where the PPO block sits, nm. Default keeps the "
                         "packing of the shipped 34-chain shell")
    ap.add_argument("--seed", type=int, default=20260911)
    a = ap.parse_args()

    rows, pos = read_gro(SRC)
    centre = pos.mean(0)
    # the chain whose PPO block sits closest to the mean, as the template
    best, best_d = 0, 1e9
    for i in range(len(rows) // PER_CHAIN):
        s = slice(i * PER_CHAIN, (i + 1) * PER_CHAIN)
        ppo = np.array([r[5:10].strip().startswith("PROX") for r in rows[s]])
        d = abs(np.linalg.norm(pos[s][ppo].mean(0) - centre) - 3.28)
        if d < best_d:
            best, best_d = i, d
    s = slice(best * PER_CHAIN, (best + 1) * PER_CHAIN)
    tmpl_rows = rows[s]
    tmpl = pos[s] - centre
    ppo = np.array([r[5:10].strip().startswith("PROX") for r in tmpl_rows])
    axis = tmpl[ppo].mean(0) - tmpl[~ppo].mean(0)       # points inward
    axis /= np.linalg.norm(axis)
    r_ppo = np.linalg.norm(tmpl[ppo].mean(0))
    radius = a.radius if a.radius else r_ppo
    # Space the chains, do not just point them. A chain is 8.9 nm long and
    # 3.4 nm across, and in the shipped shell neighbouring chains sit 3.37 nm
    # apart. Placing 50 of them on the 34-chain sphere put them 2.8 nm apart and
    # they went straight through one another: 136,330 atom pairs closer than
    # 0.9 A. The sphere is sized so that the spacing is kept instead.
    SPACING = 3.37                       # nm between neighbouring chains
    # n points on a sphere of radius R are about R * sqrt(4 pi / n) apart
    radius = SPACING / np.sqrt(4 * np.pi / a.chains)
    radius = max(radius, r_ppo)          # never tighter than the template
    print(f"  template chain {best}, PPO at {r_ppo:.2f} nm, "
          f"shell radius {radius:.2f} nm for {a.chains} chains")

    rng = np.random.default_rng(a.seed)
    dirs = fibonacci(a.chains)
    # A chain is long and flat, so pointing it outward is not enough: two
    # neighbours can still lie across one another. Each chain is placed in turn
    # and spun about its own axis until it clears the ones already down. Trying
    # angles is cheap; leaving the clash to the minimiser is not, because a
    # bond threaded through a ring does not come apart.
    from scipy.spatial import cKDTree
    placed = np.zeros((0, 3))
    tree = None
    coords, tries_used = [], []
    for d in dirs:
        R = rotation(axis, d)
        base = tmpl @ R.T
        best_q, best_bad = None, None
        for attempt in range(24):
            ang = rng.uniform(0, 2 * np.pi) if attempt else 0.0
            q = base @ spin(d, ang).T
            q = q - q[ppo].mean(0) + d * radius
            bad = 0 if tree is None else int(len(tree.query_ball_point(
                q[::8], 0.22, return_length=True).nonzero()[0]))
            if best_bad is None or bad < best_bad:
                best_q, best_bad = q, bad
            if bad == 0:
                break
        tries_used.append(attempt + 1)
        coords.append(best_q)
        placed = np.vstack([placed, best_q[::4]])
        tree = cKDTree(placed)
    print(f"  placed {len(coords)} chains, {np.mean(tries_used):.1f} orientations "
          f"tried on average")

    out, num = [], 0
    for ci, q in enumerate(coords):
        for k, r in enumerate(tmpl_rows):
            num += 1
            out.append(f"{(ci+1)%100000:>5d}{r[5:15]}{num%100000:>5d}"
                       f"{q[k,0]:8.3f}{q[k,1]:8.3f}{q[k,2]:8.3f}")

    span = float(np.abs(np.array([[float(l[20:28]), float(l[28:36]), float(l[36:44])]
                                  for l in out])).max())
    box = 2 * span + 2.0
    shift = box / 2
    fixed = [l[:20] + f"{float(l[20:28])+shift:8.3f}{float(l[28:36])+shift:8.3f}"
             f"{float(l[36:44])+shift:8.3f}" for l in out]
    Path(a.out).write_text(
        f"F127 shell, {a.chains} chains, built by make_shell.py\n"
        f"{len(fixed):>5d}\n" + "\n".join(fixed) +
        f"\n{box:10.5f}{box:10.5f}{box:10.5f}\n")
    print(f"  wrote {a.out}: {len(fixed):,} atoms, box {box:.2f} nm")


if __name__ == "__main__":
    main()
