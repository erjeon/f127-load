integrator              = md
dt                      = 0.002
nsteps                  = 1000000        ; 2 ns
nstxout-compressed      = 25000
nstxout                 = 0
nstvout                 = 0
nstfout                 = 0
nstcalcenergy           = 100
nstenergy               = 1000
nstlog                  = 1000
cutoff-scheme           = Verlet
nstlist                 = 20
vdwtype                 = Cut-off
vdw-modifier            = Force-switch
rvdw_switch             = 1.0
rvdw                    = 1.2
rlist                   = 1.2
coulombtype             = PME
rcoulomb                = 1.2
tcoupl                  = v-rescale
tc_grps                 = micelle PYR W_ION
tau_t                   = 1.0 1.0 1.0
ref_t                   = 310.15 310.15 310.15
pcoupl                  = C-rescale
pcoupltype              = isotropic
tau_p                   = 5.0
compressibility         = 4.5e-5
ref_p                   = 1.0
constraints             = h-bonds
constraint_algorithm    = LINCS
nstcomm                 = 100
comm_mode               = linear
comm_grps               = micelle PYR W_ION
gen-vel                 = yes
gen-temp                = 310.15
gen-seed                = SEEDVAL
