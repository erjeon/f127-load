integrator      = steep
emtol           = 1000.0
emstep          = 0.01
nsteps          = 50000

; No trajectory output from minimisation.
nstxout         = 0
nstvout         = 0
nstfout         = 0
nstenergy       = 1000
nstlog          = 1000

nstlist         = 10
cutoff-scheme   = Verlet
vdwtype         = Cut-off
vdw-modifier    = Force-switch
rvdw_switch     = 1.0
rvdw            = 1.2
rlist           = 1.2
coulombtype     = PME
rcoulomb        = 1.2
constraints     = h-bonds
constraint_algorithm = LINCS
